-- ==================== LÓGICA DOS RECURSOS ====================

local function getPlayerRole(player)
    local character = player.Character
    local backpack = player.Backpack
    if not character then return "Innocent" end
    
    local function check(container)
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                if tool.Name == "Knife" then return "Murderer" end
                if tool.Name == "Gun" or tool.Name == "Revolver" then return "Sheriff" end
            end
        end
        return nil
    end
    return check(character) or check(backpack) or "Innocent"
end

local espCache = {}
local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not espCache[player] then
                local drawing = Drawing.new("Text")
                drawing.Center = true
                drawing.Outline = true
                drawing.Size = 13
                drawing.Font = 2
                espCache[player] = drawing
            end
            
            local drawing = espCache[player]
            local char = player.Character
            local head = char and char:FindFirstChild("Head")
            
            local showThis = false
            if head and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
                local role = getPlayerRole(player)
                
                if Config.ESPJogadores then
                    showThis = true
                    drawing.Text = player.Name .. " (" .. role .. ")"
                    drawing.Color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or (role == "Sheriff" and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(0, 255, 0))
                elseif Config.ESPInimigos and (role == "Murderer" or role == "Sheriff") then
                    showThis = true
                    drawing.Text = player.Name .. " [" .. role .. "]"
                    drawing.Color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 150, 255)
                end
                
                if showThis then
                    local vec, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.2, 0))
                    if onScreen then
                        drawing.Position = Vector2.new(vec.X, vec.Y)
                        drawing.Visible = true
                    else
                        drawing.Visible = false
                    end
                else
                    drawing.Visible = false
                end
            else
                drawing.Visible = false
            end
        end
    end
end

local function getBestTarget()
    local bestTarget = nil
    local shortestDist = math.huge
    local myRole = getPlayerRole(LocalPlayer)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetRole = getPlayerRole(player)
            local isValid = false
            
            if myRole == "Sheriff" and targetRole == "Murderer" then isValid = true
            elseif myRole == "Murderer" and targetRole ~= "Murderer" then isValid = true
            elseif myRole == "Innocent" and targetRole == "Murderer" then isValid = true end
            
            if isValid then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestTarget = hrp
                    end
                end
            end
        end
    end
    return bestTarget
end

local mouse = LocalPlayer:GetMouse()
mouse.Button1Down:Connect(function()
    if Config.SilentAim then
        local target = getBestTarget()
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        
        if tool and (tool.Name == "Gun" or tool.Name == "Revolver") and target then
            pcall(function()
                local head = target.Parent:FindFirstChild("Head")
                if head then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                end
            end)
        end
    end
end)

