-- Função criadora de Botões Toggle na GUI
local function createToggle(name, default, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Parent = ContentContainer
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(25, 20, 20)
    ToggleFrame.BorderSizePixel = 0
    ToggleFrame.Size = UDim2.new(1, -10, 0, 35)
    
    local Label = Instance.new("TextLabel")
    Label.Parent = ToggleFrame
    Label.BackgroundTransparency = 1.00
    Label.Position = UDim2.new(0.03, 0, 0, 0)
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.Font = Enum.Font.GothamMedium
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(240, 240, 240)
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local Button = Instance.new("TextButton")
    Button.Parent = ToggleFrame
    Button.BackgroundColor3 = default and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(50, 50, 50)
    Button.Position = UDim2.new(0.88, 0, 0.2, 0)
    Button.Size = UDim2.new(0, 45, 0, 20)
    Button.AutoButtonColor = false
    Button.Text = ""
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(1, 0)
    UICorner.Parent = Button
    
    local state = default
    Button.MouseButton1Click:Connect(function()
        state = not state
        Button.BackgroundColor3 = state and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(50, 50, 50)
        callback(state)
    end)
end

