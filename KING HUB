    Corner.Parent = SectionFrame
    
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = SectionFrame
    TitleLabel.BackgroundTransparency = 1.00
    TitleLabel.Position = UDim2.new(0.05, 0, 0.03, 0)
    TitleLabel.Size = UDim2.new(0.9, 0, 0, 25)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = title
    TitleLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    TitleLabel.TextSize = 13
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    
    local InnerList = Instance.new("UIListLayout")
    InnerList.Parent = SectionFrame
    InnerList.SortOrder = Enum.SortOrder.LayoutOrder
    InnerList.Padding = UDim.new(0, 5)
    
    local Spacer = Instance.new("Frame")
    Spacer.Parent = SectionFrame
    Spacer.BackgroundTransparency = 1.00
    Spacer.Size = UDim2.new(1, 0, 0, 25)
    Spacer.LayoutOrder = -1
    
    return SectionFrame
end

