-- Identificar Papéis
local function getPlayerRole(player)
    local character = player.Character
    local backpack = player.Backpack
    if not character then return "Innocent" end
    
    local function check(container)
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                if tool.Name == "Knife" then return "Murderer" end
                if tool.Name == "Gun" or tool.Name == "Revolver" then return "Sheriff" end
            end
        end
        return nil
    end
    return check(character) or check(backpack) or "Innocent"
end

-- Obter o melhor alvo para o Silent Aim e Kill Aura
local function getBestTarget()
    local bestTarget = nil
    local shortestDist = math.huge
    local myRole = getPlayerRole(LocalPlayer)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetRole = getPlayerRole(player)
            local isValid = false
            
            if myRole == "Sheriff" and targetRole == "Murderer" then isValid = true
            elseif myRole == "Murderer" and targetRole ~= "Murderer" then isValid = true
            elseif myRole == "Innocent" and targetRole == "Murderer" then isValid = true end
            
            if isValid then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestTarget = hrp
                    end
                end
            end
        end
    end
    return bestTarget
end

-- Modificação do Silent Aim para redirecionar o disparo/ataque sem travar a câmera
local mouse = LocalPlayer:GetMouse()
mouse.Button1Down:Connect(function()
    if Config.SilentAim then
        local target = getBestTarget()
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        
        -- Se estiver com a arma ou faca equipada, redireciona o hit/foco instantaneamente ao clicar
        if tool and (tool.Name == "Knife" or tool.Name == "Gun" or tool.Name == "Revolver") and target then
            if target.Parent and target.Parent:FindFirstChild("Humanoid") then
                -- Simula o redirecionamento dos raycasts/ataques do jogo para o alvo válido
                pcall(function()
                    if tool.Name == "Gun" or tool.Name == "Revolver" then
                        -- Força o remote/direção do tiro da arma para a cabeça do alvo
                        local head = target.Parent:FindFirstChild("Head")
                        if head then
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                        end
                    else
                        -- Teleporta levemente a faca/hitbox para o alvo se for o Murderer
                        char:SetPrimaryPartCFrame(CFrame.new(target.Position + Vector3.new(0, 0, 2)))
                    end
                end)
            end
        end
    end
end)

-- Loop principal executando as funções ativadas na GUI
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    
    -- Speed
    if humanoid and Config.Speed then
        humanoid.WalkSpeed = Config.WalkSpeed
    end
    
    -- NoClip
    if char and Config.NoClip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    
    -- Kill Aura
    if Config.KillAura and char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local myRole = getPlayerRole(LocalPlayer)
        if myRole == "Murderer" then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
                    local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
                    if targetHrp and targetHum and targetHum.Health > 0 then
                        if (targetHrp.Position - hrp.Position).Magnitude <= Config.DistanciaAura then
                            pcall(function()
                                char:SetPrimaryPartCFrame(targetHrp.CFrame + Vector3.new(0, 0, 2))
                            end)
                        end
                    end
                end
            end
        end
    end
end)

